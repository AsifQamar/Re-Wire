{
  "version": 2,
  "builds": [
    {
      "src": "rewire-backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "rewire-app/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/rewire-backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/rewire-app/dist/$1"
    }
  ]
}
